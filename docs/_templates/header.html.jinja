<div class=header-text>
{% if title is not none %}   
    <h1 class="site-title"><a class="ofm-logo-link" href="https://openflexure.org/"><img class="ofm-logo" src="{{root}}assets/OpenFlexureMicroscopeLogo.svg"></a>{{title}}</h1>
{%endif %}
{% if subtitle is not none %}
    <p class="site-subtitle">{{subtitle}}</p>
{%endif %}
{% if authors is not none %}   
    <p class="author">by {{authors}}</p>
{%endif %}
{% if affiliation is not none %}
    <p class="affiliation">{{affiliation}}</p>
{%endif %}
</div>
